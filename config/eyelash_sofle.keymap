#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC        &kp N1     &kp N2        &kp N3        &kp N4         &kp N5    &kp UP_ARROW     &kp N6  &kp N7     &kp N8         &kp N9     &kp N0      &kp BACKSPACE
&kp TAB        &kp Q      &kp W         &kp E         &kp R          &kp T     &kp DOWN_ARROW   &kp Y   &kp U      &kp I          &kp O      &kp P       &kp BSLH
&kp CAPS       &kp A      &kp S         &kp D         &kp F          &kp G     &kp LEFT_ARROW   &kp H   &kp J      &kp K          &kp L      &kp SEMI    &kp APOS
&kp LSHFT      &kp Z      &kp X         &kp C         &kp V          &kp B     &kp RIGHT_ARROW  &kp N   &kp M      &kp COMMA      &kp DOT    &kp FSLH    &kp ENTER
&kp LG(LS(S))  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &kp BACKSPACE  &mo 1     &kp ENTER        &mo 2   &kp SPACE  &kp RIGHT_ALT  &kp RCTRL  &kp DELETE
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "LAYER 0";
        };

        layer_1 {
            bindings = <
&kp GRAVE         &kp F1        &kp F2     &kp F3     &kp F4     &kp F5     &mmv MOVE_UP     &kp F6     &kp F7    &kp F8      &kp F9     &kp F10           &kp F11
&trans            &kp NUMBER_6  &kp N7     &kp N8     &kp N9     &kp N0     &mmv MOVE_DOWN   &kp PG_UP  &kp END   &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
&trans            &kp F6        &kp F7     &kp F8     &kp F9     &kp F10    &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp ENTER         &kp F11       &mkp LCLK  &mkp MCLK  &mkp RCLK  &kp F12    &mmv MOVE_RIGHT  &trans     &trans    &kp INSERT  &trans     &trans            &kp F12
&kp C_PLAY_PAUSE  &kp DEL       &trans     &trans     &trans     &trans     &mkp LCLK        &trans     &trans    &trans      &trans     &trans
            >;

            display-name = "LAYER 1";
            sensor-bindings = <&inc_dec_kp LC(TAB) LS(LC(TAB))>;
        };

        layer_2 {
            bindings = <
&kp TILDE  &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans  &trans  &trans     &trans
&trans     &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans  &trans  &kp UNDER  &kp PLUS
&trans     &trans  &trans  &trans  &trans  &trans    &bt BT_PRV  &trans  &trans  &trans  &trans  &kp LBRC   &kp RBRC
&trans     &trans  &trans  &trans  &trans  &trans    &bt BT_NXT  &trans  &trans  &trans  &trans  &trans     &trans
&trans     &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            display-name = "LAYER 2";
        };

        layer_3 {
            bindings = <
&out OUT_TOG  &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_BRI  &trans           &trans           &trans           &trans           &trans           &kp K_LOCK
&trans        &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_BRD  &trans           &trans           &trans           &trans           &trans           &trans
&trans        &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_EFR  &trans           &trans           &trans           &trans           &trans           &trans
&soft_off     &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_EFF  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &trans           &bt BT_CLR
&bl BL_TOG    &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_TOG  &trans           &trans           &trans           &rgb_ug RGB_SAD  &rgb_ug RGB_BRI
            >;

            display-name = "LAYER 3";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        layers12ON {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
